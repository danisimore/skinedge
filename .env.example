# Скопируй в .env и заполни. Файл .env не попадает в git.

# Потери при конвертации валют (доля). 0.01 = 1%.
SKINEDGE_FX_SPREAD=0.01

# Свой файл правил комиссий (по умолчанию встроенный rules.yaml).
# SKINEDGE_FEE_RULES_PATH=./my_rules.yaml

# DMarket Trading API: dmarket.com → настройки аккаунта → API. Ключи дают право торговать,
# храни их только здесь. SkinEdge вызывает только методы чтения.
SKINEDGE_DMARKET_PUBLIC_KEY=
SKINEDGE_DMARKET_SECRET_KEY=
# Способ вывода с DMarket для расчёта (по умолчанию visa): sepa, payoneer, usdc, skrill...
# SKINEDGE_DMARKET_WITHDRAW=visa

# CSFloat API (csfloat.com → профиль → Developers). Подходит и имя SKINEDGE_CSFLOAT_KEY.
SKINEDGE_CSFLOAT_API_KEY=

# Telegram-бот от @BotFather и id чата для уведомлений (подходит и имя TG_BOT_TOKEN).
SKINEDGE_TELEGRAM_BOT_TOKEN=
SKINEDGE_TELEGRAM_CHAT_ID=
