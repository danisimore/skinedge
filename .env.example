# Скопируй в .env и заполни. Файл .env не попадает в git.

# Потери при конвертации валют (доля). 0.01 = 1%.
SKINEDGE_FX_SPREAD=0.01

# Свой файл правил комиссий (по умолчанию встроенный rules.yaml).
# SKINEDGE_FEE_RULES_PATH=./my_rules.yaml

# Этап 3: ключ CSFloat API (csfloat.com → профиль → вкладка developer).
SKINEDGE_CSFLOAT_API_KEY=

# Этап 6: Telegram-бот от @BotFather и id чата для уведомлений.
SKINEDGE_TELEGRAM_BOT_TOKEN=
SKINEDGE_TELEGRAM_CHAT_ID=
